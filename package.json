{
  "name": "figmadeck",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin: export frames to an editable PPTX (native text, shapes, groups) or PDF. Fully local, no network.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.ui.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixture:pptx": "node scripts/fixture-to-pptx.mjs",
    "visual": "node scripts/visual-regression.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.139.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.2.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
